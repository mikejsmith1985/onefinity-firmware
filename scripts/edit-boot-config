#!/bin/bash

# Edits config.txt, and on an A/B card also tryboot.txt (the same settings,
# starting the other slot; see ab-card).  The boot partition is /boot on the
# 2017 card and /boot/firmware on the newer OS image (1.50.0).

BOOT=/boot
[ -e /boot/firmware/config.txt ] && BOOT=/boot/firmware

for CONFIG in $BOOT/config.txt $BOOT/tryboot.txt; do
  [ -e $CONFIG ] || continue
  NAME=$(basename $CONFIG)

  cp $CONFIG /tmp/$NAME

  edit-config /tmp/$NAME "$@"

  diff $CONFIG /tmp/$NAME >/dev/null
  if [ $? -eq 1 ]; then
    mount -o remount,rw $BOOT 2>/dev/null
    mv /tmp/$NAME $BOOT/
    [ $BOOT = /boot ] && mount -o remount,ro $BOOT
  fi
done
