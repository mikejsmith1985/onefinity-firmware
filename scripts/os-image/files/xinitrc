#!/bin/bash
# The controller's screen (Onefinity OS): Chromium full screen on the
# controller's own page, restarted if it closes.
ratpoison &
xset -dpms
xset s off
xset s noblank

PREFS=$HOME/.config/chromium/Default/Preferences
while true; do
    # A crash would otherwise show a "restore pages" bar
    if [ -e "$PREFS" ]; then
        sed -i 's/"exited_cleanly":false/"exited_cleanly":true/' "$PREFS"
        sed -i 's/"exit_type":"Crashed"/"exit_type":"Normal"/' "$PREFS"
    fi
    ARGS="--kiosk --no-first-run --noerrdialogs --disable-infobars
      --disable-session-crashed-bubble --disable-translate
      --disable-features=Translate,TranslateUI --password-store=basic
      --check-for-update-interval=31536000 --disable-3d-apis --disable-gpu
      --overscroll-history-navigation=0 http://localhost/"
    # The same 750 MB ceiling the 2017 card set, so the browser can't starve
    # the controller
    systemd-run --user --scope -q -p MemoryMax=750M chromium $ARGS ||
        chromium $ARGS
    sleep 1
done
