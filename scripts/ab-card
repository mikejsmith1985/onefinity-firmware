#!/usr/bin/env python3
################################################################################
# ab-card: an SD card with two complete systems, slot A and slot B (1.47.0;
# trial-check 1.51.0).
#
# Card layout (made by "ab-card make" from the running system):
#   p1  FAT32 boot   Raspberry Pi boot firmware, config.txt, tryboot.txt,
#                    a/ and b/ (each slot's kernel, device trees, overlays,
#                    cmdline.txt and slot.json), plus a copy of slot A's
#                    kernel files at the top level as a fallback.
#   p2  ext4 rootA   slot A's root file system
#   p3  ext4 rootB   slot B's root file system
#
# config.txt ends with "os_prefix=a/" or "os_prefix=b/": the slot that starts
# normally.  tryboot.txt is the same file pointing at the other slot.  "Try"
# sets the Raspberry Pi firmware's one-shot tryboot flag and reboots, so the
# other slot starts once; any reboot or power cycle after that starts the
# normal slot again.  "Keep" changes the os_prefix line in config.txt.
#
# The running slot is never written.  New systems go into the other slot,
# from a copy of the running slot or from an OS bundle file:
#   a tar (optionally .gz/.bz2/.xz) holding ab-bundle.json first, then
#   boot/ (kernel*.img, *.dtb, overlays/, optional cmdline.txt) and root/.
#
# Written for Python 3.5 (Raspbian Stretch).  Must run as root.
################################################################################

import argparse
import datetime
import fcntl
import hashlib
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import time


FW_DIR = os.environ.get('AB_FW_DIR', '/usr/local/share/ab-card/boot-firmware')
ROOT = os.environ.get('AB_ROOT', '/')            # running root (tests change it)
RUN_DIR = os.environ.get('AB_RUN_DIR', '/run/ab-card')
JOB = os.path.join(RUN_DIR, 'job.json')
DOWNLOADS = os.path.join(ROOT, 'var/lib/bbctrl/os-update')
SLOT_PART = {'a': 2, 'b': 3}
PART_SLOT = {2: 'a', 3: 'b'}
BOOT_MiB = 512
MIN_CARD = 7 * 1000 ** 3        # a "8 GB" card is a little under 8e9 bytes
PI3_DTB = 'bcm2710-rpi-3-b.dtb'
MARK = '# --- A/B card (ab-card): the slot that starts normally ---'

# Files and folders in the boot partition that belong to a slot
def is_slot_file(name):
    return (re.match(r'^(kernel.*\.img|.*\.dtb|initrd.*|initramfs.*)$', name)
            is not None or name in ('overlays', 'cmdline.txt'))

def is_firmware_file(name):
    return re.match(r'^(bootcode\.bin|start.*\.elf|fixup.*\.dat)$', name) \
        is not None


class Fail(Exception): pass


# --- Job progress (read by the web interface) --------------------------------
job = {}
use_job = False

prog_range = [0, 100]     # a job made of parts maps its parts into this

def progress(pct, msg):
    lo, hi = prog_range
    pct = lo + (hi - lo) * pct / 100
    sys.stdout.write('%3d%% %s\n' % (pct, msg))
    sys.stdout.flush()
    if not use_job: return
    job.update(progress = int(pct), message = msg)
    write_job()

def write_job():
    os.makedirs(RUN_DIR, exist_ok = True)
    tmp = JOB + '.tmp'
    with open(tmp, 'w') as f: json.dump(job, f)
    os.rename(tmp, JOB)

def read_job():
    try:
        with open(JOB) as f: j = json.load(f)
    except Exception: return None
    # A job whose process is gone without saying so has failed
    if j.get('state') == 'running' and \
            not os.path.exists('/proc/%d' % j.get('pid', 0)):
        j['state'] = 'error'
        j['message'] = 'The job stopped unexpectedly. ' + j.get('message', '')
    return j


# --- Shell helpers -----------------------------------------------------------
def run(*cmd, **kw):
    ok = kw.pop('ok', (0,))
    p = subprocess.Popen(cmd, stdout = subprocess.PIPE,
                         stderr = subprocess.STDOUT, universal_newlines = True,
                         **kw)
    out = p.communicate()[0]
    if p.returncode not in ok:
        raise Fail('%s failed: %s' % (' '.join(cmd), out.strip()[-400:]))
    return out

def have(cmd): return shutil.which(cmd) is not None

def read(path, default = None):
    try:
        with open(path) as f: return f.read()
    except Exception: return default

def write(path, text):
    tmp = path + '.new'
    with open(tmp, 'w') as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.rename(tmp, path)

def now(): return datetime.datetime.now().strftime('%Y-%m-%d %H:%M')

def bbctrl_version():
    try:
        from importlib.metadata import version     # Python 3.8+
        return version('bbctrl')
    except Exception: pass
    try:
        import warnings
        with warnings.catch_warnings():
            warnings.simplefilter('ignore')
            import pkg_resources
        return pkg_resources.get_distribution('bbctrl').version
    except Exception: return None

def os_name(root):
    text = read(os.path.join(root, 'etc/os-release'), '')
    m = re.search(r'^PRETTY_NAME="?([^"\n]*)', text, re.M)
    return m.group(1) if m else None


# --- Devices -----------------------------------------------------------------
def part_dev(disk, n):
    return '%s%s%d' % (disk, 'p' if disk[-1].isdigit() else '', n)

def block_name_of(path):
    "The block device holding the file system at path: (disk, partition no)"
    st = os.stat(path)
    sysdev = os.path.realpath('/sys/dev/block/%d:%d' %
                              (os.major(st.st_dev), os.minor(st.st_dev)))
    part = read(os.path.join(sysdev, 'partition'))
    if part is None: return os.path.basename(sysdev), None
    return os.path.basename(os.path.dirname(sysdev)), int(part)

def running_root():
    "(disk device, partition number) of the running root file system"
    if os.environ.get('AB_ROOT_DEV'):           # tests
        dev = os.environ['AB_ROOT_DEV']
        m = re.match(r'^(.*?)p?(\d+)$', dev)
        return m.group(1), int(m.group(2))
    disk, part = block_name_of(ROOT)
    return '/dev/' + disk, part

def boot_dir():
    "Where the boot partition is mounted (Bookworm: /boot/firmware)"
    if os.environ.get('AB_BOOT'): return os.environ['AB_BOOT']
    for d in ('boot/firmware', 'boot'):
        p = os.path.join(ROOT, d)
        if os.path.exists(os.path.join(p, 'config.txt')): return p
    return os.path.join(ROOT, 'boot')

def mounts():
    out = []
    for line in read('/proc/mounts', '').splitlines():
        f = line.split()
        if len(f) >= 2: out.append((f[0], f[1].replace('\\040', ' ')))
    return out

def usb_disks():
    disks = []
    for name in sorted(os.listdir('/sys/block')):
        if not re.match(r'^sd[a-z]+$', name): continue
        path = os.path.realpath('/sys/block/' + name)
        if '/usb' not in path: continue
        size = int(read('/sys/block/%s/size' % name, '0')) * 512
        model = ' '.join(x for x in (
            (read('/sys/block/%s/device/vendor' % name) or '').strip(),
            (read('/sys/block/%s/device/model' % name) or '').strip()) if x)
        dev = '/dev/' + name
        disks.append({'device': dev, 'size': size,
                      'model': model or 'USB card reader',
                      'mounted': [m for src, m in mounts()
                                  if re.match(re.escape(dev) + r'\d*$', src)]})
    return disks


# --- Boot partition ----------------------------------------------------------
class BootRW:
    "Remount the boot partition writable while in the with block"
    def __init__(self, path): self.path = path
    def __enter__(self):
        self.remount = os.path.ismount(self.path) and not os.environ.get(
            'AB_NO_REMOUNT')
        if self.remount: run('mount', '-o', 'remount,rw', self.path)
    def __exit__(self, *a):
        os.sync()
        if self.remount:
            run('mount', '-o', 'remount,ro', self.path, ok = (0, 1, 32))

def strip_prefix_block(text):
    lines = []
    for line in text.splitlines():
        if line.strip() == MARK: continue
        if re.match(r'^\s*os_prefix\s*=', line): continue
        lines.append(line)
    while lines and lines[-1].strip() in ('', '[all]'): lines.pop()
    return '\n'.join(lines) + '\n'

def config_for(text, slot):
    return '%s\n%s\n[all]\nos_prefix=%s/\n' % (strip_prefix_block(text), MARK,
                                               slot)

def prefix_of(text):
    slot = None
    for line in (text or '').splitlines():
        m = re.match(r'^\s*os_prefix\s*=\s*([ab])/\s*$', line)
        if m: slot = m.group(1)
    return slot

def set_default(boot, slot):
    other = 'b' if slot == 'a' else 'a'
    text = read(os.path.join(boot, 'config.txt'))
    with BootRW(boot):
        write(os.path.join(boot, 'config.txt'), config_for(text, slot))
        write(os.path.join(boot, 'tryboot.txt'), config_for(text, other))

def fix_cmdline(text, part):
    text = ' '.join(text.split())
    text = re.sub(r'(^| )root=\S+', r'\1root=/dev/mmcblk0p%d' % part, text)
    if 'root=' not in text: text += ' root=/dev/mmcblk0p%d' % part
    # Never resize on an A/B card; reboot after a kernel panic (on trial that
    # goes back to the normal slot)
    text = re.sub(r' ?init=\S*init_resize\.sh', '', text)
    if not re.search(r'(^| )panic=', text): text += ' panic=10'
    return text.strip() + '\n'

def slot_bootable(boot, slot):
    d = os.path.join(boot, slot)
    return any(re.match(r'^kernel.*\.img$', n) for n in os.listdir(d)) and \
        os.path.exists(os.path.join(d, 'cmdline.txt')) \
        if os.path.isdir(d) else False


# --- Root file system --------------------------------------------------------
def fix_fstab(root, part):
    path = os.path.join(root, 'etc/fstab')
    lines, have_root = [], False
    for line in (read(path) or '').splitlines():
        f = line.split()
        if len(f) >= 2 and not line.lstrip().startswith('#'):
            if f[1] == '/':
                f[0] = '/dev/mmcblk0p%d' % part; have_root = True
                line = '  '.join(f)
            elif f[1] in ('/boot', '/boot/firmware'):
                f[0] = '/dev/mmcblk0p1'
                line = '  '.join(f)
        lines.append(line)
    if not have_root:
        lines.append('/dev/mmcblk0p%d  /  ext4  defaults,noatime  0  1' % part)
    write(path, '\n'.join(lines) + '\n')

def used_bytes(path):
    st = os.statvfs(path)
    return (st.f_blocks - st.f_bfree) * st.f_frsize

# Not copied from a running system
EXCLUDES = ['./var/swap', './tmp/*', './var/tmp/*', './var/cache/apt/archives/*.deb',
            './var/lib/bbctrl/firmware/*', './var/lib/bbctrl/os-update/*',
            './lost+found']

def copy_root(src, dst, lo, hi, what):
    "Copy a running root file system with tar, reporting progress lo..hi"
    total = max(used_bytes(src), 1)
    create = ['tar', '-C', src, '--one-file-system', '--numeric-owner',
              '--xattrs', '--xattrs-include=*', '-cpf', '-']
    for e in EXCLUDES: create += ['--exclude', e]
    create.append('.')
    extract = ['tar', '-C', dst, '--numeric-owner', '--xattrs',
               '--xattrs-include=*', '-xpf', '-']
    import tempfile
    ce, xe = tempfile.TemporaryFile(), tempfile.TemporaryFile()
    c = subprocess.Popen(create, stdout = subprocess.PIPE, stderr = ce)
    x = subprocess.Popen(extract, stdin = subprocess.PIPE, stderr = xe)
    done, last = 0, 0
    while True:
        chunk = c.stdout.read(1 << 20)
        if not chunk: break
        try: x.stdin.write(chunk)
        except BrokenPipeError:
            c.kill(); break
        done += len(chunk)
        if time.time() - last > 2:
            last = time.time()
            pct = lo + (hi - lo) * min(done / total, 1)
            progress(pct, '%s (%d of about %d MB)' %
                     (what, done >> 20, total >> 20))
    try: x.stdin.close()
    except BrokenPipeError: pass
    c.wait(); x.wait()
    ce.seek(0); xe.seek(0)
    cerr, xerr = ce.read().decode(errors = 'replace'), xe.read().decode(errors = 'replace')
    # tar exits 1 when a file changed while being read (logs on a live system)
    if c.returncode not in (0, 1): raise Fail('Reading the system failed: ' + cerr[-400:])
    if x.returncode != 0: raise Fail('Writing the card failed: ' + xerr[-400:])
    os.makedirs(os.path.join(dst, 'tmp'), exist_ok = True)
    os.chmod(os.path.join(dst, 'tmp'), 0o1777)

# Settings that follow the machine into a slot written from an OS bundle
CARRY = ['var/lib/bbctrl', 'etc/hostname', 'etc/hosts',
         'etc/wpa_supplicant/wpa_supplicant.conf',
         'etc/modprobe.d/blacklist-internal-wifi.conf',
         'etc/network/interfaces.d', 'etc/hostapd/hostapd.conf',
         'etc/dnsmasq.conf', 'etc/dhcpcd.conf']

def carry_settings(src, dst):
    for rel in CARRY + [os.path.relpath(p, src) for p in
                        sorted(_glob(os.path.join(src, 'etc/ssh/ssh_host_*')))]:
        s, d = os.path.join(src, rel), os.path.join(dst, rel)
        if not os.path.exists(s): continue
        os.makedirs(os.path.dirname(d), exist_ok = True)
        if os.path.isdir(s):
            run('tar', '-C', os.path.dirname(s), '--numeric-owner', '-cf',
                os.path.join(RUN_DIR, 'carry.tar'), '--exclude', 'firmware/*',
                '--exclude', 'os-update/*',
                os.path.basename(s))
            run('tar', '-C', os.path.dirname(d), '--numeric-owner', '-xpf',
                os.path.join(RUN_DIR, 'carry.tar'))
            os.unlink(os.path.join(RUN_DIR, 'carry.tar'))
        else: shutil.copy2(s, d)

def _glob(pat):
    import glob
    return glob.glob(pat)


# --- Firmware mailbox: the one-shot tryboot flag -----------------------------
SET_REBOOT_FLAGS, GET_REBOOT_FLAGS = 0x00038064, 0x00030064

def mailbox(tag, value = 0):
    size = struct.calcsize('P')
    ioctl = (3 << 30) | (size << 16) | (100 << 8) | 0    # _IOWR(100, 0, char *)
    buf = bytearray(struct.pack('<7I', 7 * 4, 0, tag, 4, 0, value, 0))
    fd = os.open('/dev/vcio', os.O_RDWR)
    try: fcntl.ioctl(fd, ioctl, buf, True)
    finally: os.close(fd)
    words = struct.unpack('<7I', bytes(buf))
    if words[1] != 0x80000000: raise Fail('The firmware refused the request')
    return words[5]

def set_tryboot_flag():
    "True if the firmware has the flag set, False if it can't be set this way"
    if os.environ.get('AB_FAKE_MAILBOX'): return True
    try:
        mailbox(SET_REBOOT_FLAGS, 1)
        return mailbox(GET_REBOOT_FLAGS) & 1 == 1
    except Exception: return False


# --- Status ------------------------------------------------------------------
def card_state():
    boot = boot_dir()
    disk, part = running_root()
    config = read(os.path.join(boot, 'config.txt'), '')
    ab = (os.path.isdir(os.path.join(boot, 'a')) and
          os.path.isdir(os.path.join(boot, 'b')) and prefix_of(config) and
          part in PART_SLOT and os.path.exists(part_dev(disk, 3))) or False
    s = {'ab': bool(ab), 'boot': boot, 'disk': disk, 'part': part}
    if ab:
        s['running'] = PART_SLOT[part]
        s['default'] = prefix_of(config)
        s['other'] = 'b' if s['running'] == 'a' else 'a'
        s['trial'] = s['running'] != s['default']
    return s

def slot_info(boot, slot):
    info = {}
    try:
        with open(os.path.join(boot, slot, 'slot.json')) as f: info = json.load(f)
    except Exception: pass
    info['bootable'] = slot_bootable(boot, slot)
    return info

def status():
    s = card_state()
    out = {'ab': s['ab'], 'disk': s['disk'], 'version': bbctrl_version(),
           'os': os_name(ROOT), 'job': read_job(), 'targets': usb_disks(),
           'card_size': int(read('/sys/block/%s/size' %
                                 os.path.basename(s['disk']), '0')) * 512}
    try: out['firmware'] = run('vcgencmd', 'version').splitlines()[0]
    except Exception: out['firmware'] = None
    if s['ab']:
        for k in ('running', 'default', 'other', 'trial'): out[k] = s[k]
        out['slots'] = dict((x, slot_info(s['boot'], x)) for x in 'ab')
        try:
            with open(os.path.join(s['boot'], 'ab-trial.json')) as f: t = json.load(f)
            # Asked for a trial of the other slot, but this slot is running:
            # the trial didn't start, or ended with a reboot
            if t.get('slot') != s['running']: out['trial_ended'] = t
        except Exception: pass
    return out


# --- Commands ----------------------------------------------------------------
def check_target(dev, expect_size = None, allow_mounted = False):
    disk, _ = running_root()
    if not re.match(r'^/dev/sd[a-z]+$', dev) and not os.environ.get('AB_ANY_TARGET'):
        raise Fail('%s is not a USB card reader' % dev)
    if dev == disk: raise Fail('%s holds the running system' % dev)
    name = os.path.basename(dev)
    if not os.environ.get('AB_ANY_TARGET'):
        if not any(d['device'] == dev for d in usb_disks()):
            raise Fail('%s is not a USB card reader' % dev)
    size = int(read('/sys/block/%s/size' % name, '0')) * 512
    if expect_size is not None and size != expect_size:
        raise Fail('The device at %s changed (%.1f GB now). Check the card '
                   'reader and choose it again.' % (dev, size / 1e9))
    in_use = [m for src, m in mounts() if re.match(re.escape(dev) + r'\d*$', src)]
    if in_use and not allow_mounted:
        raise Fail('%s is in use (mounted at %s). If it really is the new card, '
                   'confirm that it may be erased.' % (dev, ', '.join(in_use)))
    if size < MIN_CARD:
        raise Fail('The card is %.1f GB; it needs to be at least 8 GB' %
                   (size / 1e9))
    for src, mnt in mounts():
        if src.startswith(dev) and mnt in ('/', '/boot', '/boot/firmware'):
            raise Fail('%s is in use by the running system' % dev)
    if any(l.split()[0].startswith(dev)
           for l in read('/proc/swaps', '').splitlines()[1:] if l.strip()):
        raise Fail('%s is in use as swap' % dev)
    return size

def unmount_all(dev):
    for src, mnt in reversed(mounts()):
        if src.startswith(dev): run('umount', mnt)

def wait_for(path, secs = 15):
    end = time.time() + secs
    while not os.path.exists(path):
        if time.time() > end: raise Fail('%s did not appear' % path)
        time.sleep(0.2)

def mount(dev, where):
    os.makedirs(where, exist_ok = True)
    run('mount', dev, where)

def umount(where):
    if os.path.ismount(where): run('umount', where)

def boot_slot_source(boot):
    "Where the running system's kernel files are, and the boot folder"
    s = card_state()
    return os.path.join(boot, s['running']) if s['ab'] else boot

def copy_boot_slot(src, dst):
    os.makedirs(dst, exist_ok = True)
    for name in sorted(os.listdir(src)):
        if not is_slot_file(name): continue
        s, d = os.path.join(src, name), os.path.join(dst, name)
        if os.path.isdir(s): shutil.copytree(s, d)
        else: shutil.copyfile(s, d)

def cmd_make(dev, expect_size = None, allow_mounted = False):
    for t in ('sfdisk', 'wipefs', 'mkfs.vfat', 'mkfs.ext4', 'tar'):
        if not have(t): raise Fail('The %s program is missing' % t)
    fw = os.path.join(FW_DIR, 'bootcode.bin')
    if not os.path.exists(fw): raise Fail('Boot firmware missing from ' + FW_DIR)
    verify_firmware()
    size = check_target(dev, expect_size, allow_mounted)
    boot = boot_dir()

    progress(1, 'Preparing the card in %s' % dev)
    unmount_all(dev)
    run('wipefs', '-a', dev)

    sectors = size // 512
    start1, size1 = 8192, BOOT_MiB * 2048
    start2 = start1 + size1
    half = ((sectors - start2) // 2) // 8192 * 8192
    start3 = start2 + half
    size3 = sectors - start3        # to the very end (see resize_root_fs.sh)
    table = ('label: dos\n'
             'start=%d, size=%d, type=c, bootable\n'
             'start=%d, size=%d, type=83\n'
             'start=%d, size=%d, type=83\n') % (start1, size1, start2, half,
                                                start3, size3)
    p = subprocess.Popen(['sfdisk', '--quiet', dev], stdin = subprocess.PIPE,
                         stdout = subprocess.PIPE, stderr = subprocess.STDOUT,
                         universal_newlines = True)
    out = p.communicate(table)[0]
    if p.returncode: raise Fail('Partitioning failed: ' + out[-400:])
    if have('partprobe'): run('partprobe', dev, ok = (0, 1))
    if have('udevadm'): run('udevadm', 'settle', ok = (0, 1))
    parts = [part_dev(dev, n) for n in (1, 2, 3)]
    for p_ in parts: wait_for(p_)
    time.sleep(1)
    unmount_all(dev)          # the USB automount may have mounted old data

    progress(4, 'Formatting')
    for p_ in parts: run('wipefs', '-a', p_)
    run('mkfs.vfat', '-F', '32', '-n', 'BOOT', parts[0])
    run('mkfs.ext4', '-F', '-q', '-L', 'rootA', parts[1])
    run('mkfs.ext4', '-F', '-q', '-L', 'rootB', parts[2])
    unmount_all(dev)

    mb, ma = os.path.join(RUN_DIR, 'new-boot'), os.path.join(RUN_DIR, 'new-rootA')
    mount(parts[0], mb)
    try:
        mount(parts[1], ma)
        try:
            copy_root(ROOT, ma, 8, 90, 'Copying the system to slot A')
            progress(90, 'Setting up slot A')
            fix_fstab(ma, 2)
        finally:
            os.sync(); umount(ma)

        progress(93, 'Writing the boot files')
        make_boot(boot, mb)
        os.sync()
    finally:
        umount(mb)
    progress(100, 'The new card is ready in the card reader. Shut down, '
             'put it in the controller\'s SD slot and start up.')

def verify_firmware():
    sums = read(os.path.join(FW_DIR, 'SHA256SUMS'), '')
    if not sums: raise Fail('Boot firmware checksums missing')
    for line in sums.splitlines():
        want, name = line.split()
        with open(os.path.join(FW_DIR, name), 'rb') as f:
            if hashlib.sha256(f.read()).hexdigest() != want:
                raise Fail('Boot firmware file %s is damaged' % name)

def make_boot(boot, mb):
    src_slot = boot_slot_source(boot)
    # Everything that isn't a slot file, firmware or A/B bookkeeping
    for name in sorted(os.listdir(boot)):
        if is_slot_file(name) or is_firmware_file(name): continue
        if name in ('a', 'b', 'tryboot.txt', 'config.txt', 'lost+found') or \
                name.endswith('.new'): continue
        s = os.path.join(boot, name)
        if os.path.isdir(s): shutil.copytree(s, os.path.join(mb, name))
        else: shutil.copyfile(s, os.path.join(mb, name))
    # Current boot firmware (it knows os_prefix and tryboot)
    wanted = set(n for n in os.listdir(boot) if is_firmware_file(n))
    wanted |= {'bootcode.bin', 'start.elf', 'fixup.dat'}
    for name in sorted(wanted):
        s = os.path.join(FW_DIR, name)
        if not os.path.exists(s): s = os.path.join(boot, name)  # e.g. start_db.elf
        if os.path.exists(s): shutil.copyfile(s, os.path.join(mb, name))
    shutil.copyfile(os.path.join(FW_DIR, 'LICENCE.broadcom'),
                    os.path.join(mb, 'LICENCE.broadcom'))
    # Slot A, plus a copy at the top level, used if os_prefix is ever ignored
    cmdline = read(os.path.join(src_slot, 'cmdline.txt'), '')
    for d in (os.path.join(mb, 'a'), mb):
        copy_boot_slot(src_slot, d)
        write(os.path.join(d, 'cmdline.txt'), fix_cmdline(cmdline, 2))
    os.makedirs(os.path.join(mb, 'b'), exist_ok = True)
    write(os.path.join(mb, 'a', 'slot.json'), json.dumps({
        'label': 'Copy of the original card', 'version': bbctrl_version(),
        'os': os_name(ROOT), 'written': now(), 'proven': True}))
    config = read(os.path.join(boot, 'config.txt'), '')
    write(os.path.join(mb, 'config.txt'), config_for(config, 'a'))
    write(os.path.join(mb, 'tryboot.txt'), config_for(config, 'b'))

def need_ab(allow_trial = False):
    s = card_state()
    if not s['ab']: raise Fail('This card is not an A/B card')
    if s['trial'] and not allow_trial:
        raise Fail('Slot %s is on trial. Keep it or go back first.' %
                   s['running'].upper())
    return s

def prepare_other(s):
    other = s['other']
    dev = part_dev(s['disk'], SLOT_PART[other])
    for src, mnt in mounts():
        if os.path.realpath(src) == os.path.realpath(dev): run('umount', mnt)
    boot = s['boot']
    # Slot first marked as not startable, so a half written slot is never tried
    with BootRW(boot):
        d = os.path.join(boot, other)
        if os.path.isdir(d): shutil.rmtree(d)
        os.makedirs(d)
    run('mkfs.ext4', '-F', '-q', '-L', 'root' + other.upper(), dev)
    where = os.path.join(RUN_DIR, 'other')
    mount(dev, where)
    return other, dev, where

def finish_other(s, other, where, cmdline, label, extra):
    fix_fstab(where, SLOT_PART[other])
    info = {'label': label, 'written': now(), 'os': os_name(where)}
    info.update(extra)
    os.sync(); umount(where)
    boot = s['boot']
    with BootRW(boot):
        d = os.path.join(boot, other)
        write(os.path.join(d, 'cmdline.txt'),
              fix_cmdline(cmdline, SLOT_PART[other]))
        write(os.path.join(d, 'slot.json'), json.dumps(info))
        if other == 'a': refresh_fallback(boot)
        set_default(boot, s['default'])     # rewrites tryboot.txt too

def refresh_fallback(boot):
    "The top-level kernel files (used if os_prefix is ignored) follow slot A"
    for name in os.listdir(boot):
        if is_slot_file(name):
            p = os.path.join(boot, name)
            if os.path.isdir(p): shutil.rmtree(p)
            else: os.unlink(p)
    copy_boot_slot(os.path.join(boot, 'a'), boot)

def cmd_copy():
    s = need_ab()
    other, dev, where = prepare_other(s)
    try:
        copy_root(ROOT, where, 3, 92, 'Copying this system to slot %s' %
                  other.upper())
    except Exception:
        umount(where); raise
    progress(94, 'Writing slot %s\'s boot files' % other.upper())
    src = os.path.join(s['boot'], s['running'])
    with BootRW(s['boot']):
        copy_boot_slot(src, os.path.join(s['boot'], other))
    finish_other(s, other, where, read(os.path.join(src, 'cmdline.txt'), ''),
                 'Copy of slot %s' % s['running'].upper(),
                 {'version': bbctrl_version()})
    progress(100, 'Slot %s holds a copy of this system' % other.upper())

def sha256_of(path, lo, hi):
    h, size, done, last = hashlib.sha256(), os.path.getsize(path), 0, 0
    with open(path, 'rb') as f:
        while True:
            b = f.read(1 << 20)
            if not b: break
            h.update(b); done += len(b)
            if time.time() - last > 2:
                last = time.time()
                progress(lo + (hi - lo) * done / max(size, 1),
                         'Checking the OS file (%d of %d MB)' %
                         (done >> 20, size >> 20))
    return h.hexdigest()

def tar_member(path, member):
    "One small member of a tar file (the first one with that name)"
    return subprocess.check_output(
        ['tar', '-xOf', path, '--occurrence=1', member],
        stderr = subprocess.DEVNULL).decode()

def cmd_write(path, sha256 = None, keep_file = False):
    try: _write(path, sha256)
    finally:
        if not keep_file and path.startswith(DOWNLOADS) and os.path.exists(path):
            os.unlink(path)

def _write(path, sha256):
    s = need_ab()
    if not os.path.exists(path): raise Fail('%s not found' % path)
    progress(1, 'Checking the OS file')
    digest = sha256_of(path, 1, 15)
    if sha256 and digest != sha256.lower().strip():
        raise Fail('The OS file\'s checksum does not match (got %s)' % digest)
    try: meta = json.loads(tar_member(path, 'ab-bundle.json'))
    except Exception:
        raise Fail('This is not an OS file for the A/B card '
                   '(no ab-bundle.json inside)')
    if meta.get('format') != 1:
        raise Fail('Unknown OS file format %r' % meta.get('format'))

    other, dev, where = prepare_other(s)
    try:
        progress(16, 'Writing the system into slot %s' % other.upper())
        run('tar', '-C', where, '--numeric-owner', '--xattrs',
            '--xattrs-include=*', '--strip-components=1', '-xpf', path, 'root/')
        progress(88, 'Carrying over settings, Wi-Fi and calibration')
        carry_settings(ROOT, where)
    except Exception:
        umount(where); raise
    progress(92, 'Writing slot %s\'s boot files' % other.upper())
    d = os.path.join(s['boot'], other)
    with BootRW(s['boot']):
        run('tar', '-C', d, '--no-same-owner', '--strip-components=1',
            '-xf', path, 'boot/')
    cmdline = read(os.path.join(d, 'cmdline.txt')) or \
        read(os.path.join(s['boot'], s['running'], 'cmdline.txt'), '')
    missing = [n for n in ('kernel7.img', PI3_DTB)
               if not os.path.exists(os.path.join(d, n))]
    if missing:
        umount(where)
        with BootRW(s['boot']):
            shutil.rmtree(d); os.makedirs(d)
        raise Fail('The OS file can\'t start a Raspberry Pi 3: boot/ has no %s. '
                   'Slot %s was left empty.' % (' or '.join(missing), other.upper()))
    finish_other(s, other, where, cmdline, meta.get('label', 'OS file'),
                 {'version': meta.get('version'), 'sha256': digest})
    progress(100, 'Slot %s is ready to try' % other.upper())

def cmd_fetch(url, sha256):
    import urllib.request
    os.makedirs(DOWNLOADS, exist_ok = True)
    dst = os.path.join(DOWNLOADS, 'bundle.tar')
    progress(0, 'Downloading')
    r = urllib.request.urlopen(url, timeout = 60)
    size = int(r.headers.get('Content-Length') or 0)
    st = os.statvfs(DOWNLOADS)
    if size and st.f_bavail * st.f_frsize < size + (200 << 20):
        raise Fail('Not enough free space for a %d MB download' % (size >> 20))
    done, last = 0, 0
    with open(dst + '.part', 'wb') as f:
        while True:
            b = r.read(1 << 20)
            if not b: break
            f.write(b); done += len(b)
            if time.time() - last > 2:
                last = time.time()
                progress(100 * done / size if size else 50,
                         'Downloading (%d MB%s)' % (done >> 20,
                         ' of %d' % (size >> 20) if size else ''))
    if size and done != size: raise Fail('The download was cut short')
    os.rename(dst + '.part', dst)
    return dst

def cmd_try():
    s = need_ab()
    other = s['other']
    if not slot_bootable(s['boot'], other):
        raise Fail('Slot %s has no system to try' % other.upper())
    set_default(s['boot'], s['default'])      # fresh tryboot.txt
    if not set_tryboot_flag():
        raise Fail('The boot firmware did not accept the one-shot "try" flag, '
                   'so nothing was changed. (The card\'s boot firmware may be '
                   'too old, or this Raspberry Pi does not support it.)')
    with BootRW(s['boot']):
        write(os.path.join(s['boot'], 'ab-trial.json'),
              json.dumps({'slot': other, 'time': now()}))
    os.sync()
    if not os.environ.get('AB_NO_REBOOT'): subprocess.Popen(['reboot'])

def cmd_keep():
    s = need_ab(allow_trial = True)
    if not s['trial']: raise Fail('No slot is on trial')
    set_default(s['boot'], s['running'])
    mark_proven(s['boot'], s['running'])
    clear_trial(s['boot'])

def cmd_switch(slot):
    s = need_ab()
    if slot == s['running']: raise Fail('Slot %s is already running' %
                                        slot.upper())
    if not slot_bootable(s['boot'], slot):
        raise Fail('Slot %s has no system' % slot.upper())
    if not slot_info(s['boot'], slot).get('proven'):
        raise Fail('Slot %s has not been tried and kept yet. Try it first: '
                   'if it doesn\'t start, a power cycle comes back here.' %
                   slot.upper())
    set_default(s['boot'], slot)
    os.sync()
    if not os.environ.get('AB_NO_REBOOT'): subprocess.Popen(['reboot'])

def cmd_bundle(out, label):
    "An OS file made from the running slot (for tests, and as a backup)"
    s = card_state()
    src = os.path.join(s['boot'], s['running']) if s['ab'] else s['boot']
    stage = os.path.join(RUN_DIR, 'bundle')
    if os.path.isdir(stage): shutil.rmtree(stage)
    os.makedirs(stage)
    write(os.path.join(stage, 'ab-bundle.json'), json.dumps({
        'format': 1, 'label': label, 'version': bbctrl_version(),
        'os': os_name(ROOT), 'made': now()}))
    run('tar', '-cf', out, '-C', stage, 'ab-bundle.json')
    names = sorted(n for n in os.listdir(src) if is_slot_file(n))
    run('tar', '-rf', out, '-C', src, '--transform', r's,^,boot/,S', *names)
    cmd = ['tar', '-rf', out, '-C', ROOT, '--one-file-system',
           '--numeric-owner', '--xattrs', '--xattrs-include=*',
           # S: names only, never symlink targets ("../x" stays "../x")
           '--transform', r's,^\.,root,S']
    for e in EXCLUDES: cmd += ['--exclude', e]
    run(*(cmd + ['.']), ok = (0, 1))
    shutil.rmtree(stage)


def clear_trial(boot):
    if os.path.exists(os.path.join(boot, 'ab-trial.json')):
        with BootRW(boot): os.unlink(os.path.join(boot, 'ab-trial.json'))

def mark_proven(boot, slot):
    "A slot that has started and been kept (or the copy made from a running one)"
    path = os.path.join(boot, slot, 'slot.json')
    info = json.loads(read(path, '{}') or '{}')
    if info.get('proven'): return
    info['proven'] = True
    with BootRW(boot): write(path, json.dumps(info))

def cmd_dismiss():
    clear_trial(card_state()['boot'])


# --- Trial check: a slot on trial that isn't working goes back by itself -----
def screen_and_browser():
    "Which of the screen's programs are running: X and the browser"
    proc = os.environ.get('AB_PROC', '/proc')
    names = set()
    for pid in os.listdir(proc):
        if not pid.isdigit(): continue
        name = read(os.path.join(proc, pid, 'comm'))
        if name: names.add(name.strip())
    return {'screen': 'Xorg' in names,
            'browser': bool(names & {'chromium', 'chrome', 'chromium-browse'})}

def web_up():
    import urllib.request
    url = os.environ.get('AB_HEALTH_URL', 'http://127.0.0.1/api/config/load')
    try:
        r = urllib.request.urlopen(url, timeout = 10)
        return r.getcode() == 200
    except Exception: return False

def addresses():
    "This system's network addresses (IPv4, not loopback)"
    if 'AB_FAKE_ADDR' in os.environ:
        return os.environ['AB_FAKE_ADDR'].split()
    try:
        out = subprocess.check_output(['ip', '-4', '-o', 'addr', 'show',
                                       'scope', 'global'],
                                      stderr = subprocess.DEVNULL).decode()
    except Exception: return []
    return re.findall(r'\binet (\d+\.\d+\.\d+\.\d+)', out)

def health():
    h = screen_and_browser()
    h['web'] = web_up()
    # A slot that isn't on the network can only be fixed by taking the card
    # out, so it doesn't count as working (1.51.1)
    h['network'] = bool(addresses())
    return h

# What a slot that went back records for the normal slot to show (slot A's
# Admin > SD card page and /api/abcard return ab-trial.json as trial_ended)
DIAG = [
    ('network', ['nmcli', '-t', '-f', 'DEVICE,TYPE,STATE,CONNECTION', 'device']),
    ('radio', ['nmcli', '-t', 'radio']),
    ('rfkill', ['rfkill', '-n', '-o', 'TYPE,SOFT,HARD']),
    ('addresses', ['ip', '-4', '-o', 'addr', 'show']),
    ('NetworkManager', ['journalctl', '-b', '-u', 'NetworkManager', '-n', '20',
                        '--no-pager', '-o', 'cat']),
    ('screen', ['tail', '-n', '15', '/home/pi/xsession.log']),
    ('failed', ['systemctl', '--failed', '--no-legend', '--plain']),
]

def diagnostics():
    out = {}
    for name, cmd in DIAG:
        try:
            r = subprocess.run(cmd, stdout = subprocess.PIPE,
                               stderr = subprocess.STDOUT, timeout = 15)
            text = r.stdout.decode(errors = 'replace')
        except Exception as e: text = 'could not run: %s' % e
        out[name] = text[-1500:]
    return out

def record_trial(boot, s, result, h, diag = None):
    path = os.path.join(boot, 'ab-trial.json')
    t = json.loads(read(path, '{}') or '{}')
    t.setdefault('slot', s['running'])
    t['check'] = {'result': result, 'time': now(),
                  'not_working': sorted(k for k, v in h.items() if not v),
                  'addresses': addresses()}
    if diag is not None: t['check']['diag'] = diag
    with BootRW(boot): write(path, json.dumps(t))

def cmd_trial_check(wait = None, steady = None):
    """Run at every start.  On a slot on trial (started once with "try"):
    the controller's web server, X, the browser and a network address must
    all be up and stay
    up for `steady` seconds within `wait` seconds of the check starting.  If
    they aren't, restart: the try flag is one-shot, so the normal slot starts
    and shows that the trial ended.  Nothing is done on a slot that isn't on
    trial; once it is kept, a slot is on its own."""
    wait = wait or int(os.environ.get('AB_TRIAL_WAIT', 420))
    steady = steady or int(os.environ.get('AB_TRIAL_STEADY', 60))
    s = card_state()
    if not s['ab'] or not s['trial']:
        print('trial-check: not a slot on trial, nothing to do'); return True
    print('trial-check: slot %s is on trial; checking for %d s' %
          (s['running'].upper(), wait))
    start, good_since, h = time.time(), None, {}
    while time.time() - start < wait:
        h = health()
        if all(h.values()):
            good_since = good_since or time.time()
            if time.time() - good_since >= steady:
                print('trial-check: working (web server, screen, browser, network)')
                record_trial(s['boot'], s, 'working', h)
                return True
        else: good_since = None
        time.sleep(float(os.environ.get('AB_TRIAL_POLL', 5)))
    bad = sorted(k for k, v in h.items() if not v)
    print('trial-check: not working after %d s (%s); going back to slot %s' %
          (wait, ', '.join(bad) or 'not steady', s['default'].upper()))
    record_trial(s['boot'], s, 'not working', h,
                 {} if os.environ.get('AB_NO_DIAG') else diagnostics())
    os.sync()
    if not os.environ.get('AB_NO_REBOOT'):
        subprocess.call(['systemctl', 'reboot'])
    return False


def as_job(name, fn, *args):
    global use_job, job
    os.makedirs(RUN_DIR, exist_ok = True)
    lock = open(os.path.join(RUN_DIR, 'lock'), 'w')
    try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError: raise Fail('Another card job is running')
    use_job = True
    job = {'action': name, 'state': 'running', 'progress': 0, 'message': '',
           'pid': os.getpid(), 'started': now()}
    write_job()
    try:
        fn(*args)
        job['state'] = 'done'
    except Exception as e:
        job['state'] = 'error'
        job['message'] = str(e)
        write_job()
        raise
    job['finished'] = now()
    write_job()


def main():
    ap = argparse.ArgumentParser(description = 'A/B SD card tool')
    sub = ap.add_subparsers(dest = 'cmd')
    sub.add_parser('status')
    m = sub.add_parser('make'); m.add_argument('device')
    m.add_argument('--yes', action = 'store_true')
    m.add_argument('--size', type = int, help = 'the size the user was shown')
    m.add_argument('--mounted-ok', action = 'store_true',
                   help = 'erase even though it is mounted')
    sub.add_parser('copy')
    w = sub.add_parser('write'); w.add_argument('file')
    w.add_argument('--sha256')
    f = sub.add_parser('fetch'); f.add_argument('url')
    f.add_argument('--sha256')
    sub.add_parser('try')
    sub.add_parser('keep')
    sw = sub.add_parser('switch'); sw.add_argument('slot', choices = ('a', 'b'))
    sub.add_parser('dismiss')
    sub.add_parser('trial-check', help = 'go back to the normal slot if this '
                   'slot on trial is not working (run at start)')
    b = sub.add_parser('bundle'); b.add_argument('out')
    b.add_argument('--label', default = 'Saved system')
    args = ap.parse_args()

    try:
        if args.cmd == 'status' or args.cmd is None:
            print(json.dumps(status(), indent = 1, sort_keys = True))
        elif args.cmd == 'make':
            if not args.yes: raise Fail('Add --yes: everything on %s is erased' %
                                        args.device)
            as_job('make', cmd_make, args.device, args.size, args.mounted_ok)
        elif args.cmd == 'copy': as_job('copy', cmd_copy)
        elif args.cmd == 'write': as_job('write', cmd_write, args.file, args.sha256)
        elif args.cmd == 'fetch':
            def fetch_write():
                prog_range[:] = [0, 40]
                path = cmd_fetch(args.url, args.sha256)
                prog_range[:] = [40, 100]
                cmd_write(path, args.sha256)
            as_job('write', fetch_write)
        elif args.cmd == 'try': cmd_try()
        elif args.cmd == 'keep': cmd_keep()
        elif args.cmd == 'switch': cmd_switch(args.slot)
        elif args.cmd == 'dismiss': cmd_dismiss()
        elif args.cmd == 'trial-check': cmd_trial_check()
        elif args.cmd == 'bundle': cmd_bundle(args.out, args.label)
    except Exception as e:
        sys.stderr.write('ab-card: %s\n' % e)
        sys.exit(1)


if __name__ == '__main__': main()
